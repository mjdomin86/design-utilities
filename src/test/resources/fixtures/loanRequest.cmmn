<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/cmmn" xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI" xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC" xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI" xmlns:design="http://flowable.org/design" targetNamespace="http://flowable.org/cmmn" design:palette="flowable-work-case-palette">
  <case id="loanRequest" name="Loan Request with auto AI" flowable:initiatorVariableName="initiator" flowable:candidateStarterGroups="flowableUser">
    <documentation>In this case model, a customer can request a new loan. The loans range from simple loans for e.g. a car, to mortgage loans for buying a house.</documentation>
    <casePlanModel id="onecaseplanmodel1" name="Case plan model" flowable:formKey="loanApplication1" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:custom-view-element customViewKey="myCase" menuNavigationSize="expanded"></flowable:custom-view-element>
        <flowable:default-menu-navigation-size><![CDATA[expanded]]></flowable:default-menu-navigation-size>
        <flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation>
        <flowable:agentmodel><![CDATA[agentv5]]></flowable:agentmodel>
        <design:stencilid><![CDATA[CasePlanModel]]></design:stencilid>
      </extensionElements>
      <planItem id="planItemExpandedStage_1" name="Initial screening" definitionRef="ExpandedStage_1"></planItem>
      <planItem id="planItemExpandedStage_40" name="Document review" definitionRef="ExpandedStage_40">
        <entryCriterion id="EntryCriterion_41" sentryRef="sentryEntryCriterion_41"></entryCriterion>
      </planItem>
      <planItem id="planItemExpandedStage_47" name="Risks" definitionRef="ExpandedStage_47">
        <entryCriterion id="EntryCriterion_68" sentryRef="sentryEntryCriterion_68"></entryCriterion>
      </planItem>
      <planItem id="planItemMilestone_70" name="Waiting for user to upload documents" definitionRef="Milestone_70">
        <entryCriterion id="EntryCriterion_71" sentryRef="sentryEntryCriterion_71"></entryCriterion>
      </planItem>
      <planItem id="planItemMilestone_78" name="Id provided" definitionRef="Milestone_78">
        <entryCriterion id="EntryCriterion_79" sentryRef="sentryEntryCriterion_79"></entryCriterion>
      </planItem>
      <planItem id="planItemMilestone_75" name="Pyaslip provided" definitionRef="Milestone_75">
        <entryCriterion id="EntryCriterion_76" sentryRef="sentryEntryCriterion_76"></entryCriterion>
      </planItem>
      <planItem id="planItemProcessTask_28" name="Escalate to customer relations" definitionRef="ProcessTask_28">
        <entryCriterion id="EntryCriterion_29" sentryRef="sentryEntryCriterion_29"></entryCriterion>
      </planItem>
      <planItem id="planItemIntentEventListener_59" name="Customer escalation" definitionRef="IntentEventListener_59"></planItem>
      <planItem id="planItemIntentEventListener_61" name="payslip and id provided" definitionRef="IntentEventListener_61"></planItem>
      <planItem id="planItemIntentEventListener_65" name="Cancel Application" definitionRef="IntentEventListener_65"></planItem>
      <planItem id="planItemIntentEventListener_73" name="Payslip provided" definitionRef="IntentEventListener_73"></planItem>
      <planItem id="planItemIntentEventListener_74" name="Id provided" definitionRef="IntentEventListener_74"></planItem>
      <sentry id="sentryExitCriterion_66">
        <extensionElements>
          <design:stencilid><![CDATA[ExitCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartExitCriterion_66" sourceRef="planItemIntentEventListener_65">
          <standardEvent>occur</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_41">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_41" sourceRef="planItemIntentEventListener_61">
          <standardEvent>occur</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_68">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_68" sourceRef="planItemExpandedStage_40">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_71">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_71" sourceRef="planItemExpandedStage_1">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_79">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_79" sourceRef="planItemIntentEventListener_74">
          <standardEvent>occur</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_76">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_76" sourceRef="planItemIntentEventListener_73">
          <standardEvent>occur</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentryEntryCriterion_29">
        <extensionElements>
          <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
        </extensionElements>
        <planItemOnPart id="sentryOnPartEntryCriterion_29" sourceRef="planItemIntentEventListener_59">
          <standardEvent>occur</standardEvent>
        </planItemOnPart>
      </sentry>
      <stage id="ExpandedStage_1" name="Initial screening" autoComplete="true">
        <extensionElements>
          <design:stencilid><![CDATA[ExpandedStage]]></design:stencilid>
          <design:bgcolor><![CDATA[#fffff]]></design:bgcolor>
          <design:autoexecutewithai><![CDATA[without]]></design:autoexecutewithai>
        </extensionElements>
        <planItem id="planItemHumanTask_61" name="Additional check when amount &gt; 10000 USD" definitionRef="HumanTask_61">
          <itemControl>
            <manualActivationRule>
              <extensionElements>
                <flowable:aiActivationType><![CDATA[ai-automatic]]></flowable:aiActivationType>
              </extensionElements>
            </manualActivationRule>
          </itemControl>
        </planItem>
        <planItem id="planItemHumanTask_62" name="Loan application is for a car" definitionRef="HumanTask_62">
          <itemControl>
            <manualActivationRule>
              <extensionElements>
                <flowable:aiActivationType><![CDATA[ai-suggestion]]></flowable:aiActivationType>
              </extensionElements>
            </manualActivationRule>
          </itemControl>
        </planItem>
        <planItem id="planItemHumanTask_63" name="Loan application is for a house" definitionRef="HumanTask_63">
          <itemControl>
            <manualActivationRule>
              <extensionElements>
                <flowable:aiActivationType><![CDATA[ai-suggestion]]></flowable:aiActivationType>
              </extensionElements>
            </manualActivationRule>
          </itemControl>
        </planItem>
        <planItem id="planItemHumanTask_29" name="Manual review of application" definitionRef="HumanTask_29"></planItem>
        <humanTask id="HumanTask_61" name="Additional check when amount &gt; 10000 USD" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
          <extensionElements>
            <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
            <design:stencilid><![CDATA[HumanTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
            <design:bgcolor><![CDATA[#a6dfed]]></design:bgcolor>
            <flowable:ai-instruction><![CDATA[Enable this task only if the loanAmount is greater than 10000.]]></flowable:ai-instruction>
          </extensionElements>
        </humanTask>
        <humanTask id="HumanTask_62" name="Loan application is for a car" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
          <extensionElements>
            <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
            <design:stencilid><![CDATA[HumanTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
            <flowable:ai-instruction><![CDATA[Enable this task only if the reasons clearly expresses the user’s intent to buy or purchase a car/vehicle.]]></flowable:ai-instruction>
          </extensionElements>
        </humanTask>
        <humanTask id="HumanTask_63" name="Loan application is for a house" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
          <extensionElements>
            <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
            <design:stencilid><![CDATA[HumanTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
            <flowable:ai-instruction><![CDATA[Enable this task only if the reasons clearly expresses the user’s intent to buy or purchase a house/apartment.]]></flowable:ai-instruction>
          </extensionElements>
        </humanTask>
        <humanTask id="HumanTask_29" name="Manual review of application" flowable:assignee="${initiator}" flowable:formKey="reviewDataForm" flowable:formFieldValidation="false">
          <extensionElements>
            <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
            <design:stencilid><![CDATA[HumanTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
          </extensionElements>
        </humanTask>
      </stage>
      <stage id="ExpandedStage_40" name="Document review" autoComplete="true">
        <extensionElements>
          <design:stencilid><![CDATA[ExpandedStage]]></design:stencilid>
        </extensionElements>
        <planItem id="planItemProcessTask_58" name="Document verification" definitionRef="ProcessTask_58"></planItem>
        <planItem id="planItemHumanTask_66" name="Secondary Verification" definitionRef="HumanTask_66">
          <entryCriterion id="EntryCriterion_67" sentryRef="sentryEntryCriterion_67"></entryCriterion>
        </planItem>
        <sentry id="sentryEntryCriterion_67">
          <extensionElements>
            <flowable:condition group="true" match="all" targetAttribute="condition">
              <flowable:condition sourceVariableType="variable" sourceName="identityVerified" operator="equals" targetVariableType="value" targetValue="false" targetType="boolean"></flowable:condition>
            </flowable:condition>
            <design:stencilid><![CDATA[EntryCriterion]]></design:stencilid>
          </extensionElements>
          <planItemOnPart id="sentryOnPartEntryCriterion_67" sourceRef="planItemProcessTask_58">
            <standardEvent>complete</standardEvent>
          </planItemOnPart>
          <ifPart id="sentryIfPart_EntryCriterion_67">
            <condition><![CDATA[${vars:equals(identityVerified, false)}]]></condition>
          </ifPart>
        </sentry>
        <processTask id="ProcessTask_58" name="Document verification" flowable:fallbackToDefaultTenant="true" flowable:sameDeployment="true">
          <extensionElements>
            <design:stencilid><![CDATA[ProcessTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
            <flowable:in source="documents" target="documents"></flowable:in>
            <flowable:in source="applicantFirstName" target="applicantFirstName"></flowable:in>
            <flowable:in source="applicantLastName" target="applicantLastName"></flowable:in>
            <flowable:out source="identityVerified" target="identityVerified"></flowable:out>
          </extensionElements>
          <processRefExpression><![CDATA[documentVerification1]]></processRefExpression>
        </processTask>
        <humanTask id="HumanTask_66" name="Secondary Verification" flowable:assignee="${initiator}" flowable:formKey="reviewDocumentsTasks1" flowable:formFieldValidation="false">
          <extensionElements>
            <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
            <design:stencilid><![CDATA[HumanTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
          </extensionElements>
        </humanTask>
      </stage>
      <stage id="ExpandedStage_47" name="Risks">
        <extensionElements>
          <design:stencilid><![CDATA[ExpandedStage]]></design:stencilid>
        </extensionElements>
        <planItem id="planItemProcessTask_50" name="Credit check" definitionRef="ProcessTask_50"></planItem>
        <processTask id="ProcessTask_50" name="Credit check" flowable:fallbackToDefaultTenant="true" flowable:sameDeployment="true">
          <extensionElements>
            <design:stencilid><![CDATA[ProcessTask]]></design:stencilid>
            <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
          </extensionElements>
          <processRefExpression><![CDATA[creditCheck1]]></processRefExpression>
        </processTask>
      </stage>
      <milestone id="Milestone_70" name="Waiting for user to upload documents" flowable:milestoneVariable="Waiting for user to upload documents">
        <extensionElements>
          <design:stencilid><![CDATA[Milestone]]></design:stencilid>
        </extensionElements>
      </milestone>
      <milestone id="Milestone_78" name="Id provided" flowable:milestoneVariable="Id provided">
        <extensionElements>
          <design:stencilid><![CDATA[Milestone]]></design:stencilid>
        </extensionElements>
      </milestone>
      <milestone id="Milestone_75" name="Pyaslip provided" flowable:milestoneVariable="Pyaslip provided">
        <extensionElements>
          <design:stencilid><![CDATA[Milestone]]></design:stencilid>
        </extensionElements>
      </milestone>
      <processTask id="ProcessTask_28" name="Escalate to customer relations" flowable:fallbackToDefaultTenant="true" flowable:sameDeployment="true">
        <extensionElements>
          <design:stencilid><![CDATA[ProcessTask]]></design:stencilid>
          <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
          <flowable:in source="applicantFirstName" target="applicantFirstName"></flowable:in>
          <flowable:in source="applicantLastName" target="applicantLastName"></flowable:in>
        </extensionElements>
        <processRefExpression><![CDATA[escalateToCustomerRelations1]]></processRefExpression>
      </processTask>
      <eventListener id="IntentEventListener_59" name="Customer escalation" flowable:eventType="intent">
        <documentation>This should not be in the prompt</documentation>
        <extensionElements>
          <flowable:ai-instruction><![CDATA[This intent should be triggered when detecting that the loan applicant is angry or frustrated.]]></flowable:ai-instruction>
          <design:stencilid><![CDATA[IntentEventListener]]></design:stencilid>
          <design:stencilsuperid><![CDATA[EventListener]]></design:stencilsuperid>
          <design:completionneutral><![CDATA[false]]></design:completionneutral>
          <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        </extensionElements>
      </eventListener>
      <eventListener id="IntentEventListener_61" name="payslip and id provided" flowable:eventType="intent">
        <documentation>This intent must be activated when a payslip and id document are uploaded in this case</documentation>
        <extensionElements>
          <design:stencilid><![CDATA[IntentEventListener]]></design:stencilid>
          <design:stencilsuperid><![CDATA[EventListener]]></design:stencilsuperid>
          <design:completionneutral><![CDATA[false]]></design:completionneutral>
          <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        </extensionElements>
      </eventListener>
      <eventListener id="IntentEventListener_65" name="Cancel Application" flowable:eventType="intent">
        <documentation>Do not include this in the prompt</documentation>
        <extensionElements>
          <flowable:ai-instruction><![CDATA[This intent should trigger when the loan applicant indicates they want to cancel the application]]></flowable:ai-instruction>
          <design:stencilid><![CDATA[IntentEventListener]]></design:stencilid>
          <design:stencilsuperid><![CDATA[EventListener]]></design:stencilsuperid>
          <design:completionneutral><![CDATA[false]]></design:completionneutral>
          <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        </extensionElements>
      </eventListener>
      <eventListener id="IntentEventListener_73" name="Payslip provided" flowable:eventType="intent">
        <documentation>This intent must be activated when a payslip is uploaded in this case</documentation>
        <extensionElements>
          <design:stencilid><![CDATA[IntentEventListener]]></design:stencilid>
          <design:stencilsuperid><![CDATA[EventListener]]></design:stencilsuperid>
          <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        </extensionElements>
      </eventListener>
      <eventListener id="IntentEventListener_74" name="Id provided" flowable:eventType="intent">
        <documentation>This intent must be activated when a id document is uploaded in this case</documentation>
        <extensionElements>
          <design:stencilid><![CDATA[IntentEventListener]]></design:stencilid>
          <design:stencilsuperid><![CDATA[EventListener]]></design:stencilsuperid>
          <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        </extensionElements>
      </eventListener>
      <exitCriterion id="ExitCriterion_66" sentryRef="sentryExitCriterion_66"></exitCriterion>
    </casePlanModel>
  </case>
